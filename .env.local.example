# AssemblyAI API Key
# Get your key at: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Geheime header waarmee AssemblyAI de webhook (/api/webhook) aanroept.
# Genereer met: openssl rand -hex 32
ASSEMBLYAI_WEBHOOK_SECRET=

# OpenRouter (AI-verwerking: opschonen, samenvatting, actiepunten, verslagen)
OPENROUTER_API_KEY=

# Base URL — wordt gebruikt voor de AssemblyAI-webhook en auth-redirects.
# Lokaal (http://localhost) wordt de webhook overgeslagen; de app pollt dan zelf.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: N8N Webhook URL for notifications
N8N_WEBHOOK_URL=

# Database URL (Postgres — productie draait op Neon)
DATABASE_URL="postgresql://user:password@host/db"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Beveiliging van /api/cron/keep-alive (Neon wakker houden). Leeg = geen check.
CRON_SECRET=

# Optioneel: map voor tijdelijke upload-stukken (standaard: os.tmpdir()/transcriptie-uploads)
# UPLOAD_TMP_DIR=/app/uploads
# Optioneel: maximale bestandsgrootte in bytes (standaard 2 GB)
# MAX_UPLOAD_BYTES=2147483648
